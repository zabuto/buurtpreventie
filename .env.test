# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Booting the kernel builds the entity manager, which needs a URL even when a test never connects. Port 1 never
# answers, so without a real DATABASE_URL (Symfony CLI or CI, which take precedence over this file) the database
# tests skip instead of reaching some other server.
DATABASE_URL="mysql://unset:unset@127.0.0.1:1/unset"

# Public key for the hash chain of the audit log in tests only; every installation makes its own.
AUDIT_SECRET=audit-secret-for-tests-only
