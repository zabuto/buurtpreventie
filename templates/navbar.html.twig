{% macro navbar_item(route, label) %}
    {% set _current_route = app.request.attributes.get('_route') %}
    {% set _class = '' %}
    {% if route is same as(_current_route) %}
        {% set _class = 'active' %}
    {% endif %}
    <a class="nav-item nav-link {{ _class }}" href="{{ path(route) }}">
        {{ label|trans }}
    </a>
{% endmacro %}

<nav class="navbar sticky-top navbar-light bg-light navbar-expand-lg">
    <a class="navbar-brand" href="{{ path('home') }}">
        <img src="{{ asset('images/favicon-32x32.png') }}" class="d-inline-block align-top" alt="">
        {% trans %}app.title{% endtrans %}
    </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarMenu"
            aria-controls="navbarMenu" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMenu">
        <div class="navbar-nav mr-auto mt-2 mt-lg-0">
            {% if is_granted('ROLE_USER') %}
                {{ _self.navbar_item('calendar', 'walk.schema') }}

                {% if is_granted('ROLE_WALK') %}
                    {{ _self.navbar_item('walked_list', 'walk.walked-rounds') }}
                {% endif %}

                {% if is_granted('ROLE_COORDINATE') or is_granted('ROLE_ANALYST') %}
                    {{ _self.navbar_item('result_list', 'walk.results') }}
                {% endif %}

                {% if is_granted('ROLE_MEMBER') %}
                    {{ _self.navbar_item('member_list', 'user.members') }}
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    {{ _self.navbar_item('user_list', 'user.users') }}
                {% endif %}
            {% endif %}
        </div>
        <div class="navbar-nav my-2 my-lg-0">
            {% if is_granted('ROLE_USER') %}
                <a class="nav-item nav-link nav-account mr-4 d-none d-lg-block text-dark" href="{{ path('account') }}">
                    <i class="fas fa-user fa-lg"></i><span class="pl-2">{{ app.user }}</span>
                </a>
                <a class="nav-item nav-link d-block d-lg-none" href="{{ path('account') }}">
                    {% trans %}user.account{% endtrans %}
                </a>
                <a class="btn btn-outline-primary d-none d-lg-block" href="{{ path('app_logout') }}">
                    {% trans %}security.logout{% endtrans %}
                    <i class="fas fa-sign-out-alt"></i>
                </a>
                <a class="nav-item nav-link d-block d-lg-none" href="{{ path('app_logout') }}">
                    {% trans %}security.logout{% endtrans %}
                </a>
            {% else %}
                <a class="btn btn-outline-primary d-none d-lg-block" href="{{ path('app_login') }}">
                    {% trans %}security.login{% endtrans %}
                    <i class="fas fa-sign-in-alt"></i>
                </a>
            {% endif %}
        </div>
    </div>
</nav>
