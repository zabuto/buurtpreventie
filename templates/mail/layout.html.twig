<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ subject }}</title>
{# Inline styles carry the light colours, as some mail programs drop a style block; programs that follow dark mode
   read this block, and !important lets it win over the inline styles. #}
<style>
@media (prefers-color-scheme: dark) {
  .bp-page { background-color:#000000 !important; }
  .bp-card { background-color:#121212 !important; }
  .bp-text { color:#e5e7eb !important; }
  .bp-muted { color:#a1a1aa !important; border-top-color:#3f3f46 !important; }
  .bp-brand { color:{{ brand.darkColor }} !important; }
  .bp-logo { background-color:#ffffff !important; padding:8px !important; }
}
</style>
</head>
<body class="bp-page" style="padding:0;background-color:#f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f4f5" class="bp-page" style="background-color:#f4f4f5;">
<tr>
<td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#ffffff" class="bp-card" style="max-width:600px;background-color:#ffffff;">
<tr>
<td style="padding:24px 24px 16px 24px;">
{% if brand.hasLogo %}
<img src="cid:logo" alt="{{ brand.name }}" class="bp-logo" style="max-width:100%;height:auto;max-height:64px;border:0;">
{% else %}
<span class="bp-brand" style="font-family:Arial,Helvetica,sans-serif;font-size:20px;color:{{ brand.color }};"><strong>{{ brand.name }}</strong></span>
{% endif %}
</td>
</tr>
<tr>
<td style="padding:0 24px 8px 24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
{% block content %}{% endblock %}
</table>
</td>
</tr>
<tr>
<td class="bp-muted" style="padding:16px 24px 24px 24px;border-top:1px solid #e5e7eb;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#4b5563;">
{{ 'layout.from'|trans({name: brand.name}, 'mail', locale) }} {{ (brand.canReply ? 'layout.reply' : 'layout.no_reply')|trans({}, 'mail', locale) }}
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
