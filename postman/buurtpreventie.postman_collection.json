          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers an OpenAPI 3.1 document', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().openapi).to.match(/^3\\.1/);",
                  "});"
                ]
              }
            }
          ]
        }
