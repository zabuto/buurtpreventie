        {
          "name": "Read the code from Mailpit (local only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailpitUrl}}/api/v1/message/latest",
              "host": [
                "{{mailpitUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "message",
                "latest"
              ]
            },
            "description": "Development only: Mailpit catches the mail locally. Skipped without the variable mailpitUrl, which only the local environment sets."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('mailpitUrl')) {",
                  "    console.log('Skipped: no mailpitUrl, so not a local run');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const found = /(\\d{3} \\d{3})/.exec(pm.response.json().Text || '');",
                  "pm.test('finds the code in the newest mail', () => pm.expect(found).to.not.equal(null));",
                  "if (found) {",
                  "    pm.collectionVariables.set('code', found[1]);",
                  "}"
                ]
              }
            }
          ]
        },
