  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The app takes a changing request of the browser only from its own origin; a browser says so in",
          "// Sec-Fetch-Site, which Postman and Newman do not send by themselves.",
          "pm.request.headers.upsert({ key: 'Sec-Fetch-Site', value: 'same-origin' });",
          "pm.request.headers.upsert({ key: 'Accept-Language', value: pm.variables.get('language') || 'nl' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://buurtpreventie.wip"
