{
    "name": "zabuto/buurtpreventie",
    "type": "project",
    "license": "PolyForm-Noncommercial-1.0.0",
    "description": "Buurtpreventie: plan neighbourhood watch rounds, find a walking buddy and report back",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.27",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.8",
        "nelmio/api-doc-bundle": "^5.13",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        },
        "policy": {
            "cooldown": {
                "period": "24 hours"
            }
        },
        "process-timeout": 0
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Tools\\": "tools/"
        },
        "exclude-from-classmap": [
            "tests/Architecture/Fixtures/"
        ]
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts",
            "@php tools/opengrep-release.php check-major"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test:coverage": [
            "@php vendor/bin/phpunit --colors=never --coverage-text=var/coverage/coverage.txt"
        ],
        "test:unit": [
            "@php vendor/bin/phpunit --exclude-group integration --exclude-group functional --exclude-group database"
        ],
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@php bin/console cache:warmup --env=dev",
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config",
            "@deprecations",
            "vendor/bin/mago format --dry-run",
            "vendor/bin/mago lint --minimum-fail-level warning",
            "vendor/bin/mago analyze --minimum-fail-level error",
            "@php vendor/bin/rector process --dry-run",
            "@php vendor/bin/phpstan analyse --no-progress",
            "@test"
        ],
        "fix": [
            "@php vendor/bin/rector process",
            "vendor/bin/mago lint --fix",
            "vendor/bin/mago format"
        ],
        "deprecations": [
            "@php bin/console debug:container --deprecations | tee /dev/stderr | grep -q 'There are no deprecations'"
        ]
    },
    "conflict": {
        "symfony/symfony": "*",
        "zircote/swagger-php": ">=7"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "carthage-software/mago": "^1.60",
        "dama/doctrine-test-bundle": "^8.8",
        "doctrine/data-fixtures": "^2.2",
        "phpat/phpat": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "phpstan/phpstan-phpunit": "*",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "^13",
        "rector/rector": "*",
        "symfony/browser-kit": "7.4.*"
    },
    "scripts-descriptions": {
        "test": "Runs the test suite",
        "test:coverage": "Runs the test suite and writes the coverage per class to var/coverage/coverage.txt; needs pcov or Xdebug",
        "test:unit": "Runs the in-memory unit tests only",
        "check": "Runs every check CI runs",
        "fix": "Applies Rector, Mago lint fixes and Mago formatting",
        "deprecations": "Fails when building the container triggered a deprecation"
    }
}
