# PHP names itself and its exact version in X-Powered-By when expose_php is on; the app removes it as well, but this
# also covers responses that never reach PHP's response handling, such as a fatal error. Apache keeps the header of a
# success response and of an error response in separate tables, so each needs its own unset.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>
