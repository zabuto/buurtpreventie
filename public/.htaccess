# PHP names its exact version in X-Powered-By when expose_php is on; the app replaces it as well, but this also covers
# responses that never reach PHP's response handling, such as a fatal error. The unset clears PHP's value from the
# success table, which "always set" does not touch, so the version never appears next to the fixed value.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Powered-By "PHP Symfony"
</IfModule>
